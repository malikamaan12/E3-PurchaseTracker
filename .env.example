# Core application configuration
DATABASE_URL=postgresql://user:password@localhost:5432/purchasetracker
JWT_SECRET=replace-with-a-long-random-production-secret
RATE_LIMIT_SALT=replace-with-a-separate-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vendor-management rollout flags
NEXT_PUBLIC_FF_QUICK_VENDOR_CREATE=true
NEXT_PUBLIC_FF_DYNAMIC_COMPLIANCE_ENGINE=true
NEXT_PUBLIC_FF_NON_BLOCKING_PR=true
NEXT_PUBLIC_FF_COMPLIANCE_MATRIX_UI=true

# Cloudflare R2 document storage
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=purchasetracker-documents

# Google Drive backup integration (optional)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={}
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_PRIMARY_ID=
GOOGLE_DRIVE_FOLDER_SECONDARY_ID=

# Scheduled tasks and optional AI analysis
CRON_SECRET=replace-with-a-long-random-secret
ENABLE_AI_ANALYSIS=false
ANTHROPIC_API_KEY=

# Email notifications (Resend)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=PurchaseTracker <onboarding@resend.dev>

